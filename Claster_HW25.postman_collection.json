	"item": [
		{
			"name": "Get request movies",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"if(pm.response.status.code === 500){\r",
							"    throw new Error(\"Connect Failed\")\r",
							"}\r",
							"\r",
							"\r",
							"if (pm.response.code === 200) {\r",
							"    let jsonData = pm.response.json();\r",
							"\r",
							"    pm.test(\"Первые 10 документов содержат genres\", function () {\r",
							"        jsonData.slice(0, 10).forEach(doc => {\r",
							"            pm.expect(doc).to.have.property(\"genres\");\r",
							"        });\r",
							"    });\r",
							"}\r",
							"\r",
							"\r",
							"if (pm.response.code === 200) { let jsonData = pm.response.json(); pm.test(\"Все документы содержат genres\", function () { jsonData.forEach(doc => { pm.expect(doc).to.have.property(\"genres\"); }); }); }\r",
							"\r",
							"if (pm.response.code === 200) { let jsonData = pm.response.json(); pm.test(\"Все документы содержат languages\", function () { jsonData.forEach(doc => { pm.expect(doc).to.have.property(\"languages\"); }); }); }\r",
							"\r",
							"\r",
							"if (pm.response.code === 200) {\r",
							"    let jsonData = pm.response.json();\r",
							"\r",
							"    pm.test(\"Все документы содержат plot ≤ 300 символов\", function () {\r",
							"        jsonData.forEach((doc, index) => {\r",
							"            pm.expect(doc).to.have.property(\"plot\");\r",
							"            pm.expect(doc.plot.length, `Документ #${index + 1} (${doc.title || \"без названия\"})`)\r",
							"                .to.be.at.most(300);\r",
							"        });\r",
							"    });\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
